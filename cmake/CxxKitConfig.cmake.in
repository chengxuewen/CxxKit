@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

#-----------------------------------------------------------------------------------------------------------------------
# Vendored 3rdparty dependencies (vcpkg-style: find each library's own installed
# Config.cmake, which carries full transitive dependency chains, e.g.
#   spdlogConfig -> find_dependency(fmt)
#   cprConfig    -> find_dependency(CURL)  (OpenSSL/ZLIB gated OFF at build)
# Headers are namespaced under include/cxxkit/3rdparty/<lib>/; static libs are in lib/.
#-----------------------------------------------------------------------------------------------------------------------
foreach(_dep IN ITEMS @CXXKIT_VENDORED_FIND_DEPS@)
    find_dependency(${_dep} CONFIG
        PATHS "${PACKAGE_PREFIX_DIR}/lib/cmake"
        NO_DEFAULT_PATH)
endforeach()

# Tracy headers are namespaced under include/cxxkit/3rdparty/tracy/; drop the official
# include/tracy path from the imported target so it does not dangle in the install tree.
if(TARGET Tracy::TracyClient)
    set_property(TARGET Tracy::TracyClient PROPERTY INTERFACE_INCLUDE_DIRECTORIES "")
endif()

# Header-only / lite 3rdparty without installed Configs: keep INTERFACE stub targets
# so exported link interfaces resolve. These contribute headers only (namespaced
# include path comes from cxxkit targets).
set(_cxxkit_3rdparty_libdir "${PACKAGE_PREFIX_DIR}/lib")
foreach(_stub_spec IN ITEMS
        "CxxKitWrapFmt::WrapFmt;"
        "CxxKitWrapStringViewLite::WrapStringViewLite;"
        "CxxKitWrapOptional::WrapOptional;"
        "CxxKitWrapExpected::WrapExpected;"
        "CxxKitWrapConcurrentQueue::WrapConcurrentQueue;"
        "CxxKitWrapReaderWriterQueue::WrapReaderWriterQueue;"
        "CxxKitWrapFunction2::WrapFunction2;"
        "CxxKitWrapFilesystem::WrapFilesystem;"
        "CxxKitWrapSpdlog::WrapSpdlog;"
        "CxxKitWrapVariant::WrapVariant;"
        "CxxKitWrapBenchmark::WrapBenchmark;"
        "CxxKitWrapLibcpr::WrapLibcpr;"
        "CxxKitWrapLibcurl::WrapLibcurl;"
        "CxxKitWrapMbedTLS::WrapMbedTLS;")
    string(REPLACE ";" "|" _stub_parts "${_stub_spec}")
    string(REPLACE "|" ";" _stub_list "${_stub_parts}")
    list(GET _stub_list 0 _stub_target)
    if(NOT TARGET "${_stub_target}")
        add_library("${_stub_target}" INTERFACE IMPORTED)
    endif()
endforeach()

# libyuv/spdlog/fmt ship static libs but no find_dependency target wired to the
# exported wrap stubs — point the stubs at the installed static libs so exported
# cxxkit targets (tools/thread/media) link transitive deps (M3: static libs ship).
foreach(_wrap_spec IN ITEMS
        "CxxKitWrapLibyuv::WrapLibyuv|libyuv.a;"
        "CxxKitWrapSpdlog::WrapSpdlog|libspdlogd.a;"
        "CxxKitWrapFmt::WrapFmt|libfmt.a")
    string(REPLACE "|" ";" _wrap_parts ${_wrap_spec})
    list(GET _wrap_parts 0 _wrap_target)
    list(GET _wrap_parts 1 _wrap_lib)
    if(NOT TARGET "${_wrap_target}")
        add_library("${_wrap_target}" INTERFACE IMPORTED)
    endif()
    if(EXISTS "${PACKAGE_PREFIX_DIR}/lib/${_wrap_lib}")
        set_property(TARGET "${_wrap_target}" PROPERTY INTERFACE_LINK_LIBRARIES "${PACKAGE_PREFIX_DIR}/lib/${_wrap_lib}")
    endif()
endforeach()

# libuv stub (B2, closes B1 C-1): libuv's own Config (find_dependency above) provides
# libuv::uv_a WITH its transitive link libs (pthread;dl;rt) — delegate to it when present;
# fall back to the raw static lib for consumers that skip the find_dependency chain.
if(NOT TARGET CxxKitWrapLibuv::WrapLibuv)
    add_library(CxxKitWrapLibuv::WrapLibuv INTERFACE IMPORTED)
endif()
if(TARGET libuv::uv_a)
    set_property(TARGET CxxKitWrapLibuv::WrapLibuv PROPERTY INTERFACE_LINK_LIBRARIES libuv::uv_a)
elseif(EXISTS "${PACKAGE_PREFIX_DIR}/lib/libuv.a")
    set_property(TARGET CxxKitWrapLibuv::WrapLibuv PROPERTY INTERFACE_LINK_LIBRARIES "${PACKAGE_PREFIX_DIR}/lib/libuv.a")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cxxkitTargets.cmake")

# Component support: each component maps to an exported target (cxxkit::<comp>)
foreach(_comp ${cxxkit_FIND_COMPONENTS})
    if(TARGET cxxkit::${_comp})
        set(cxxkit_${_comp}_FOUND TRUE)
    elseif(cxxkit_FIND_REQUIRED_${_comp})
        set(cxxkit_FOUND FALSE)
    endif()
endforeach()

check_required_components(cxxkit)
