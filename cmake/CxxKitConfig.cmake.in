@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

#-----------------------------------------------------------------------------------------------------------------------
# Vendored 3rdparty dependencies (vcpkg-style: find each library's own installed
# Config.cmake, which carries full transitive dependency chains, e.g.
#   spdlogConfig -> find_dependency(fmt)
#   cprConfig    -> find_dependency(CURL)  (OpenSSL/ZLIB gated OFF at build)
# Headers are namespaced under include/cxxkit/3rdparty/<lib>/; static libs are in lib/.
#-----------------------------------------------------------------------------------------------------------------------
foreach(_dep IN ITEMS
        fmt
        spdlog
        cpr
        CURL
        MbedTLS)
    find_dependency(${_dep} CONFIG
        PATHS "${PACKAGE_PREFIX_DIR}/lib/cmake"
        NO_DEFAULT_PATH)
endforeach()

# Header-only / lite 3rdparty without installed Configs: keep INTERFACE stub targets
# so exported link interfaces resolve. These contribute headers only (namespaced
# include path comes from cxxkit targets).
set(_cxxkit_3rdparty_libdir "${PACKAGE_PREFIX_DIR}/lib")
foreach(_stub_spec IN ITEMS
        "CXXKitWrapFmt::WrapFmt;"
        "CXXKitWrapStringViewLite::WrapStringViewLite;"
        "CXXKitWrapOptional::WrapOptional;"
        "CXXKitWrapExpected::WrapExpected;"
        "CXXKitWrapConcurrentQueue::WrapConcurrentQueue;"
        "CXXKitWrapReaderWriterQueue::WrapReaderWriterQueue;"
        "CXXKitWrapFunction2::WrapFunction2;"
        "CXXKitWrapFilesystem::WrapFilesystem;"
        "CXXKitWrapSpdlog::WrapSpdlog;"
        "CXXKitWrapVariant::WrapVariant;"
        "CXXKitWrapBenchmark::WrapBenchmark;"
        "CXXKitWrapLibcpr::WrapLibcpr;"
        "CXXKitWrapLibcurl::WrapLibcurl;"
        "CXXKitWrapMbedTLS::WrapMbedTLS;")
    string(REPLACE ";" "|" _stub_parts "${_stub_spec}")
    string(REPLACE "|" ";" _stub_list "${_stub_parts}")
    list(GET _stub_list 0 _stub_target)
    if(NOT TARGET "${_stub_target}")
        add_library("${_stub_target}" INTERFACE IMPORTED)
    endif()
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/cxxkitTargets.cmake")

# Component support: each component maps to an exported target (cxxkit::<comp>)
foreach(_comp ${cxxkit_FIND_COMPONENTS})
    if(TARGET cxxkit::${_comp})
        set(cxxkit_${_comp}_FOUND TRUE)
    elseif(cxxkit_FIND_REQUIRED_${_comp})
        set(cxxkit_FOUND FALSE)
    endif()
endforeach()

check_required_components(cxxkit)
