# Configure helpers: generate cxxkit/base/core_config.hpp with platform/size/feature macros.
# Replaces OpenCTK's octk_configure_* compile-test machinery with standard CMake modules
# (CheckTypeSize) — same output macros, simpler implementation.
#
########################################################################################################################

# cxxkit_configure_definition(NAME [VALUE value])
# Registers a compile definition on the global list (consumed by cxxkit_configure_library_end).
set(CXXKIT_GLOBAL_COMPILE_DEFINITIONS "")

function(cxxkit_configure_definition name)
    cxxkit_parse_all_arguments(arg "cxxkit_configure_definition" "PUBLIC;PRIVATE" "VALUE" "" ${ARGN})
    if(NOT "${arg_VALUE}" STREQUAL "")
        set(def "${name}=${arg_VALUE}")
    else()
        set(def "${name}")
    endif()
    set(CXXKIT_GLOBAL_COMPILE_DEFINITIONS ${CXXKIT_GLOBAL_COMPILE_DEFINITIONS} "${def}" CACHE INTERNAL "" FORCE)
endfunction()

function(cxxkit_configure_library_begin name)
    set(CXXKIT_CURRENT_LIBRARY "${name}" CACHE INTERNAL "" FORCE)
endfunction()

function(cxxkit_configure_library_end name)
    # Attach global compile definitions to the library target
    if(TARGET "${name}")
        target_compile_definitions(${name} PUBLIC ${CXXKIT_GLOBAL_COMPILE_DEFINITIONS})
    endif()
endfunction()

# cxxkit_generate_core_config()
# Generates ${CMAKE_CURRENT_BINARY_DIR}/cxxkit/base/core_config.hpp consumed by cxxkit/base headers.
function(cxxkit_generate_core_config)
    include(CheckTypeSize)

    set(_config_lines "")
    list(APPEND _config_lines "// Generated by cxxkit CMake configure. Do not edit.")
    list(APPEND _config_lines "#ifndef CXXKIT_CORE_CONFIG_HPP")
    list(APPEND _config_lines "#define CXXKIT_CORE_CONFIG_HPP")
    list(APPEND _config_lines "")
    list(APPEND _config_lines "// Version")
    list(APPEND _config_lines "#define CXXKIT_VERSION_NAME \"${PROJECT_VERSION}\"")
    list(APPEND _config_lines "#define CXXKIT_VERSION_MAJOR ${PROJECT_VERSION_MAJOR}")
    list(APPEND _config_lines "#define CXXKIT_VERSION_MINOR ${PROJECT_VERSION_MINOR}")
    list(APPEND _config_lines "#define CXXKIT_VERSION_PATCH ${PROJECT_VERSION_PATCH}")
    list(APPEND _config_lines "#define CXXKIT_VERSION_TWEAK ${PROJECT_VERSION_TWEAK}")
    list(APPEND _config_lines "")
    list(APPEND _config_lines "// Features (defaults from OpenCTK configure.cmake)")
    list(APPEND _config_lines "#define CXXKIT_FEATURE_USE_STD_STEADY_CLOCK 1")
    list(APPEND _config_lines "#define CXXKIT_FEATURE_ENABLE_HARDENING_ASSERT 1")
    list(APPEND _config_lines "")
    list(APPEND _config_lines "// Build")
    if(BUILD_SHARED_LIBS)
        list(APPEND _config_lines "#define CXXKIT_BUILD_SHARED 1")
    else()
        list(APPEND _config_lines "#define CXXKIT_BUILD_STATIC 1")
    endif()
    if(CMAKE_BUILD_TYPE STREQUAL "Debug")
        list(APPEND _config_lines "#define CXXKIT_BUILD_DEBUG 1")
    endif()
    string(TIMESTAMP COMPILE_TIME "%Y%m%d_%H%M%S")
    list(APPEND _config_lines "#define CXXKIT_COMPILE_TIME \"${COMPILE_TIME}\"")
    list(APPEND _config_lines "")
    list(APPEND _config_lines "// C++ standard in effect")
    list(APPEND _config_lines "#define CXXKIT_BUILD_CXX_STANDARD_11 1")
    if(NOT CXXKIT_FEATURE_CXX_STANDARD LESS 14)
        list(APPEND _config_lines "#define CXXKIT_BUILD_CXX_STANDARD_14 1")
    endif()
    if(NOT CXXKIT_FEATURE_CXX_STANDARD LESS 17)
        list(APPEND _config_lines "#define CXXKIT_BUILD_CXX_STANDARD_17 1")
    endif()
    if(NOT CXXKIT_FEATURE_CXX_STANDARD LESS 20)
        list(APPEND _config_lines "#define CXXKIT_BUILD_CXX_STANDARD_20 1")
    endif()
    if(NOT CXXKIT_FEATURE_CXX_STANDARD LESS 23)
        list(APPEND _config_lines "#define CXXKIT_BUILD_CXX_STANDARD_23 1")
    endif()
    if(NOT CXXKIT_FEATURE_CXX_STANDARD LESS 26)
        list(APPEND _config_lines "#define CXXKIT_BUILD_CXX_STANDARD_26 1")
    endif()
    list(APPEND _config_lines "")
    list(APPEND _config_lines "// Type presence (0/1)")
    foreach(_type IN ITEMS INT8_T INT16_T INT32_T INT64_T UINT8_T UINT16_T UINT32_T UINT64_T INT128 FLOAT128 WCHAR_T CHAR8_T CHAR16_T CHAR32_T SSIZE_T PTRDIFF_T)
        string(TOLOWER "${_type}" _ctype_lower)
        string(REPLACE "_t" "_t" _ctype "${_ctype_lower}")
        if(_type STREQUAL "INT128")
            set(_ctype "__int128")
        elseif(_type STREQUAL "FLOAT128")
            set(_ctype "__float128")
        elseif(_type STREQUAL "CHAR8_T")
            set(_ctype "char8_t")
        elseif(_type STREQUAL "SSIZE_T")
            set(_ctype "ssize_t")
        elseif(_type STREQUAL "PTRDIFF_T")
            set(_ctype "ptrdiff_t")
        endif()
        check_type_size("${_ctype}" CXXKIT_TS_${_type} LANGUAGE CXX)
        if(CXXKIT_TS_${_type})
            list(APPEND _config_lines "#define CXXKIT_HAS_${_type} 1")
        else()
            list(APPEND _config_lines "#define CXXKIT_HAS_${_type} 0")
        endif()
    endforeach()
    list(APPEND _config_lines "")
    list(APPEND _config_lines "// Type sizes (bytes)")
    foreach(_type IN ITEMS CHAR SHORT INT LONG LONG_LONG UCHAR USHORT UINT ULONG ULONG_LONG VOID_P SIZE_T SSIZE_T PTRDIFF_T)
        if(_type STREQUAL "VOID_P")
            set(_ctype "void*")
        elseif(_type STREQUAL "SIZE_T")
            set(_ctype "size_t")
        elseif(_type STREQUAL "SSIZE_T")
            set(_ctype "ssize_t")
        elseif(_type STREQUAL "PTRDIFF_T")
            set(_ctype "ptrdiff_t")
        elseif(_type STREQUAL "LONG_LONG")
            set(_ctype "long long")
        elseif(_type STREQUAL "UCHAR")
            set(_ctype "unsigned char")
        elseif(_type STREQUAL "ULONG")
            set(_ctype "unsigned long")
        elseif(_type STREQUAL "ULONG_LONG")
            set(_ctype "unsigned long long")
        else()
            string(TOLOWER "${_type}" _ctype)
        endif()
        check_type_size("${_ctype}" CXXKIT_TS_SIZE_${_type} LANGUAGE CXX)
        list(APPEND _config_lines "#define CXXKIT_SIZEOF_${_type} ${CXXKIT_TS_SIZE_${_type}}")
    endforeach()
    list(APPEND _config_lines "")
    list(APPEND _config_lines "// Int64 / size_t representation hints")
    if(CXXKIT_SIZEOF_LONG EQUAL 8)
        list(APPEND _config_lines "#define CXXKIT_INT64_IS_LONG_TYPE 1")
    else()
        list(APPEND _config_lines "#define CXXKIT_INT64_IS_LONG_TYPE 0")
    endif()
    if(NOT CXXKIT_SIZEOF_LONG EQUAL 8)
        list(APPEND _config_lines "#define CXXKIT_INT64_IS_LONG_LONG_TYPE 1")
    else()
        list(APPEND _config_lines "#define CXXKIT_INT64_IS_LONG_LONG_TYPE 0")
    endif()
    list(APPEND _config_lines "#define CXXKIT_SIZET_IS_SHORT_TYPE 0")
    list(APPEND _config_lines "#define CXXKIT_SIZET_IS_INT_TYPE 0")
    if(CXXKIT_SIZEOF_SIZE_T EQUAL CXXKIT_SIZEOF_LONG)
        list(APPEND _config_lines "#define CXXKIT_SIZET_IS_LONG_TYPE 1")
    else()
        list(APPEND _config_lines "#define CXXKIT_SIZET_IS_LONG_TYPE 0")
    endif()
    if(NOT CXXKIT_SIZEOF_SIZE_T EQUAL CXXKIT_SIZEOF_LONG AND NOT CXXKIT_SIZEOF_SIZE_T EQUAL CXXKIT_SIZEOF_INT)
        list(APPEND _config_lines "#define CXXKIT_SIZET_IS_LONG_LONG_TYPE 1")
    else()
        list(APPEND _config_lines "#define CXXKIT_SIZET_IS_LONG_LONG_TYPE 0")
    endif()
    list(APPEND _config_lines "")
    list(APPEND _config_lines "#endif // CXXKIT_CORE_CONFIG_HPP")

    string(JOIN "\n" _config_content ${_config_lines})
    file(MAKE_DIRECTORY "${PROJECT_BINARY_DIR}/cxxkit/base")
    file(WRITE "${PROJECT_BINARY_DIR}/cxxkit/base/core_config.hpp" "${_config_content}\n")
    message(STATUS "Generated core_config.hpp at ${PROJECT_BINARY_DIR}/cxxkit/base/core_config.hpp")
endfunction()
