*.pyc

# Binaries
# --------
*.dll
*.exe
*.so*

# IDE files
# --------
.idea
.cache
.vscode

# CMake files
# --------
CMakeLists.txt.user

# Build dirs
# --------
cmake-build*
build*
# vcpkg bootstrap clones (cxxkit_vcpkg_install) + any repo-root vcpkg artifacts;
# anchored so scripts/crash-deps/vcpkg.json (a source file) is NOT ignored
/vcpkg/
/vcpkg-tools/

# Temp dirs
# --------
node_modules
install
refsrc
nodejs
stash

# Runtime state
# --------
.omo

# Don't ignore files
# --------
!.vscode/settings.json
!.omo/omo.jsonc
# crash-deps export cache (scripts/export_crash_deps.sh) — build cache, not sources
3rdparty/*.7z
3rdparty/*.7z.version